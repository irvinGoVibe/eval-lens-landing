{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build",
    "start": "next start --port 3005",
    "lint": "eslint",
    "test:browsers:install": "playwright install chromium firefox webkit && playwright-mcp install-browser chrome-for-testing",
    "test:mcp:browser:install": "playwright-mcp install-browser chrome-for-testing",
    "test:build": "next build",
    "test:e2e": "playwright test tests/smoke.spec.ts --project=desktop-chromium --project=desktop-webkit",
    "test:smoke:chromium": "playwright test tests/smoke.spec.ts --project=desktop-chromium",
    "test:smoke:webkit": "playwright test tests/smoke.spec.ts --project=desktop-webkit",
    "test:mobile": "playwright test tests/compatibility.spec.ts --project=mobile-chromium --project=mobile-webkit --project=iphone-se --project=iphone-13 --project=iphone-14-pro --project=iphone-14-pro-max --project=ipad-mini --project=ipad",
    "test:mobile:qa:audit": "node mobile-tests/run-mobile-audit.mjs audit",
    "test:mobile:qa:chromium": "node mobile-tests/run-mobile-audit.mjs audit --project=mobile-qa-chromium",
    "test:mobile:qa:webkit": "node mobile-tests/run-mobile-audit.mjs audit --project=mobile-qa-webkit",
    "test:mobile:qa:retest": "node mobile-tests/run-mobile-audit.mjs retest",
    "test:visual": "playwright test tests/visual.spec.ts --project=mobile-chromium --project=mobile-webkit",
    "test:visual:update": "playwright test tests/visual.spec.ts --project=mobile-chromium --project=mobile-webkit --update-snapshots",
    "test:overflow": "playwright test tests/overflow.spec.ts --project=mobile-chromium --project=mobile-webkit",
    "test:a11y": "playwright test tests/accessibility.spec.ts --project=desktop-chromium --project=desktop-webkit",
    "test:regression": "playwright test --project=desktop-chromium --project=desktop-firefox --project=desktop-webkit --project=mobile-chromium --project=mobile-webkit",
    "test:safari:iphone:doctor": "node tests/real-safari/iphone-audit.mjs doctor",
    "test:safari:iphone": "node tests/real-safari/iphone-audit.mjs audit",
    "test:browserstack:iphone": "node tests/browserstack/real-iphone-safari.mjs",
    "test:report": "playwright show-report",
    "audit:safari": "pnpm test:build && playwright test tests/compatibility.spec.ts tests/overflow.spec.ts tests/visual.spec.ts tests/accessibility.spec.ts --project=desktop-webkit --project=mobile-webkit --project=iphone-se --project=iphone-13 --project=iphone-14-pro --project=iphone-14-pro-max --project=ipad-mini --project=ipad",
    "audit:recheck": "pnpm audit:safari"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.108.2",
    "gsap": "^3.15.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.78",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "axe-core": "4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
